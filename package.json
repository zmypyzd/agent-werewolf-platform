{
  "name": "agent-poker-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0 <21"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run --workspace vitest.workspace.ts",
    "test:watch": "vitest --workspace vitest.workspace.ts",
    "test:coverage": "vitest run --coverage --workspace vitest.workspace.ts",
    "typecheck": "pnpm -r run build --noEmit 2>&1 | grep -v 'warning\\|info' || true",
    "lint": "pnpm -r exec tsc -p tsconfig.json --noEmit",
    "dev:api": "pnpm --filter api dev",
    "demo": "pnpm --filter local-simulation start",
    "demo:local": "pnpm --filter local-simulation start"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "prettier": "3.8.3",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
